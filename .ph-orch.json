{
  "kitVersion": "v3",
  "DOCS": "docs",
  "DECISIONS": "docs/decisions",
  "DECISIONS_REL": "decisions",
  "LEDGER": "docs/wip/LEDGER.md",
  "LEDGER_REL": "wip/LEDGER.md",
  "MAIN_BRANCH": "main",
  "VERIFY_CMD": "pnpm build && pnpm lint && pnpm test:run && pnpm --filter @pepperhorn/chordl-react build:site",
  "WORKTREE_SETUP": "pnpm install --frozen-lockfile && pnpm build && cp \"$(git worktree list | head -1 | cut -d' ' -f1)/.env\" .env  (packages resolve each other from dist, so build before lint/test; .env comes only from the main checkout; T3 project setup does not copy it)",
  "PORT_BASE": "5200",
  "REMOTE": "origin",
  "MERGE": "merge",
  "GBRAIN_PROJECT": "chordl",
  "IMPL_PROVIDER": "codex",
  "IMPL_MODEL": "gpt-6.1-sol",
  "IMPL_OPTIONS": "{\"reasoningEffort\":\"high\"}",
  "ALT_PROVIDER": "claudeAgent",
  "ALT_MODEL": "claude-sonnet-5-5",
  "ALT_OPTIONS": "{\"effort\":\"high\"}",
  "REVIEW_PROVIDER": "claudeAgent",
  "REVIEW_MODEL": "claude-opus-5-5",
  "REVIEW_OPTIONS": "{\"effort\":\"high\"}",
  "ALT_REVIEW_PROVIDER": "codex",
  "ALT_REVIEW_MODEL": "gpt-6.1-sol",
  "ALT_REVIEW_OPTIONS": "{\"reasoningEffort\":\"high\"}",
  "AUTO_MERGE": "small",
  "AUTO_MERGE_MAX_LINES": "50",
  "SWEEP_PRS": true,
  "SCAN_DAYS": 7,
  "STOP_MAX_BLOCKS": 3,
  "AUTO_MERGE_EXCLUDE": [
    "docs/handoffs/**"
  ]
}
