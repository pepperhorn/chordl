{
  "name": "@pepperhorn/chordl-react",
  "version": "0.4.0",
  "description": "React component library for SVG piano chord diagrams",
  "type": "module",
  "main": "./dist/chordl.js",
  "module": "./dist/chordl.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chordl.js",
      "default": "./dist/chordl.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "fonts/OFL.txt",
    "fonts/README.md",
    "soundfonts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "fonts:build": "node scripts/build-verovio-fonts.mjs && node scripts/embed-verovio-fonts.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@pepperhorn/chordl-core": "workspace:*",
    "@pepperhorn/chordl-guitar": "workspace:*",
    "@pepperhorn/chordl-listen": "workspace:*",
    "@pepperhorn/chordl-voicings": "workspace:*",
    "jszip": "^3.10.1",
    "smplr": "^0.18.1",
    "soundfont2": "^0.5.0",
    "svguitar": "^2.5.1",
    "tonal": "^6.3.0",
    "verovio": "^6.2.0"
  },
  "devDependencies": {
    "@pepperhorn/chordl-board": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
