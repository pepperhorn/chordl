{
  "name": "@pepperhorn/chordl-guitar",
  "version": "0.2.0",
  "description": "Guitar/ukulele chord-shape lookup and svguitar diagram data \u2014 chords-db backed, with alternate fret positions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.10"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:top3": "node scripts/build-top3.mjs",
    "build": "pnpm run build:data && tsc",
    "lint": "pnpm run build:data && tsc --noEmit",
    "test": "pnpm run build:data && vitest",
    "test:run": "pnpm run build:data && vitest run"
  },
  "dependencies": {
    "@tombatossals/chords-db": "^0.5.1",
    "svguitar": "^2.5.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
